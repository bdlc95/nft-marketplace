{
  "name": "nft-marketplace-challenge",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mocks": "vite --mode mock --host 127.0.0.1",
    "dev:scenarios": "vite --mode scenarios --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "build:scenarios": "npm run typecheck && vite build --mode scenarios",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test --config playwright.scenarios.config.ts tests/discovery.spec.ts tests/realtime.spec.ts tests/commerce.spec.ts",
    "test:e2e:ui": "playwright test --config playwright.scenarios.config.ts --ui",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:report": "playwright show-report",
    "audit": "node scripts/audit.mjs",
    "prepare": "msw init public --save",
    "test:network": "node scripts/check-network.mjs",
    "test:business": "node scripts/check-network.mjs scripts/check-business-entry.ts"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.35",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "msw": "2.10.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
